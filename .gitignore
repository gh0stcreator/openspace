node_modules/

# Состав команды и настройки этой машины: меняются от каждого клика в интерфейсе
# и создаются заново из DEFAULTS при первом запуске.
openspace.config.json

# Локальные папки соседних инструментов
.gstack/

# Сборка веб-клиента: собирается из web/ командой npm run build.
# Слэш в начале обязателен: иначе правило ловит и web/public — а это исходники.
/public/

# Разговоры и вложения — это данные конкретной машины, а не код
rooms/

# В репозитории только инструмент. Всё, над чем работают в пространстве — статьи,
# черновики, чужие проекты, — остаётся на машине: это содержимое работы, а не код.
drafts/

.DS_Store
*.log

# Смешарики: чужой товарный знак, а в репозитории лежит инструмент.
# Механика персон в режиме — часть инструмента и едет в git; сами персонажи — нет.
archetypes/крош.md
archetypes/совунья.md
archetypes/лосяш.md
archetypes/пин.md
archetypes/нюша.md
archetypes/ёжик.md
archetypes/кар-карыч.md
archetypes/бараш.md
archetypes/копатыч.md
modes/смешарики.md
