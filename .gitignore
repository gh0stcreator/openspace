node_modules/

# Состав команды и настройки этой машины: меняются от каждого клика в интерфейсе
# и создаются заново из DEFAULTS при первом запуске.
openspace.config.json

# Локальные папки соседних инструментов
.gstack/

# Сборка веб-клиента: собирается из web/ командой npm run build.
# Слэш в начале обязателен: иначе правило ловит и web/public — а это исходники.
/public/

# Разговоры и вложения — это данные конкретной машины, а не код
rooms/

.DS_Store
*.log
