#!/usr/bin/env node
/**
 * Нанять участника в чат, уволить или посмотреть состав.
 *
 *   ./bin/hire qa --role qa --engine claude
 *   ./bin/hire designer --role designer --engine codex
 *   ./bin/hire editor --role editor --engine claude --model sonnet
 *   ./bin/hire --list
 *   ./bin/hire --fire qa
 *
 * Правит openspace.config.json. Сервер читает конфиг при старте — перезапусти его после найма.
 */
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { listRoles, loadRole } from '../lib/roles.js';

const root = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
const file = path.join(root, 'openspace.config.json');
const args = process.argv.slice(2);

const opt = (name) => {
  const i = args.indexOf(`--${name}`);
  if (i === -1) return null;
  const v = args[i + 1];
  args.splice(i, 2);
  return v;
};
const has = (name) => {
  const i = args.indexOf(`--${name}`);
  if (i === -1) return false;
  args.splice(i, 1);
  return true;
};

const cfg = JSON.parse(fs.readFileSync(file, 'utf8'));
const save = () => fs.writeFileSync(file, JSON.stringify(cfg, null, 2) + '\n');

const ENGINES = ['claude', 'codex'];

function showTeam() {
  console.log('Команда:\n');
  for (const [name, a] of Object.entries(cfg.agents)) {
    const r = loadRole(a.role);
    const model = a.model ? ` · ${a.model}` : '';
    console.log(`  ${r.icon}  @${name.padEnd(12)} ${r.title.padEnd(14)} на ${a.kind ?? name}${model}`);
  }
  console.log(`\n  🧑  @${cfg.human.padEnd(12)} человек\n`);
  console.log('Свободные роли:', listRoles().map((r) => r.name).join(', '));
  console.log('Движки:', ENGINES.join(', '));
}

if (has('list') || args.length === 0) {
  showTeam();
  process.exit(0);
}

const fire = opt('fire');
if (fire) {
  if (!cfg.agents[fire]) {
    console.error(`в команде нет @${fire}`);
    process.exit(1);
  }
  delete cfg.agents[fire];
  save();
  console.log(`@${fire} уволен. Перезапусти сервер.`);
  process.exit(0);
}

const role = opt('role');
const engine = opt('engine') ?? 'claude';
const model = opt('model');
const trust = opt('trust');
const name = args[0];

if (!name || name.startsWith('-')) {
  console.error('нужно имя: ./bin/hire qa --role qa --engine claude');
  process.exit(1);
}
if (!/^[a-zA-Z0-9_\-Ѐ-ӿ]+$/.test(name)) {
  console.error(`ник «${name}» не годится: буквы, цифры, дефис`);
  process.exit(1);
}
if (name === cfg.human) {
  console.error(`@${name} — это ты`);
  process.exit(1);
}
if (!ENGINES.includes(engine)) {
  console.error(`движок «${engine}» неизвестен, есть: ${ENGINES.join(', ')}`);
  process.exit(1);
}

const known = listRoles().map((r) => r.name);
if (!role) {
  console.error(`нужна роль: --role <${known.join('|')}>`);
  console.error('или заведи новую файлом в roles/ — см. roles/README.md');
  process.exit(1);
}
if (!known.includes(role)) {
  console.error(`роли «${role}» нет в roles/. Есть: ${known.join(', ')}`);
  console.error(`Заведи её файлом roles/${role}.md — см. roles/README.md`);
  process.exit(1);
}

const existed = Boolean(cfg.agents[name]);
cfg.agents[name] = {
  kind: engine,
  label: name,
  role,
  trust: trust ?? cfg.agents[name]?.trust ?? 'safe',
  lean: true,
  ...(engine === 'claude' ? { settingSources: 'project' } : { reasoningEffort: 'low' }),
  ...(model ? { model } : {}),
  timeoutMs: cfg.agents[name]?.timeoutMs ?? 300000,
};
save();

const r = loadRole(role);
console.log(`${r.icon} @${name} — ${r.title} на ${engine}${model ? ` (${model})` : ''} ${existed ? 'обновлён' : 'нанят'}.`);
console.log('Перезапусти сервер, чтобы он появился в чате.');
