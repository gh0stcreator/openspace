#!/usr/bin/env node
/**
 * Рабочий запуск: сервер плюс пересборка клиента на каждую правку.
 *
 * Участники правят файлы, но команд не запускают, — без наблюдателя их правка
 * в интерфейсе не появляется, и кто-то должен руками собирать за ними. Теперь
 * не должен: `node bin/dev` держит и то, и другое.
 */
import { spawn } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const root = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
const args = process.argv.slice(2);

const watcher = spawn('npm', ['--prefix', 'web', 'run', 'build', '--', '--watch'], {
  cwd: root, stdio: 'inherit',
});
const server = spawn(process.execPath, ['server.js', ...args], { cwd: root, stdio: 'inherit' });

const stop = () => { watcher.kill('SIGTERM'); server.kill('SIGTERM'); };
process.on('SIGINT', stop);
process.on('SIGTERM', stop);

// Падение сборки клиента не должно ронять сервер: ошибка в web/ — это ошибка в web/,
// комната при этом продолжает работать на прошлой сборке.
watcher.on('exit', (code) => {
  if (code) console.error(`\nсборка клиента остановилась (код ${code}); сервер работает дальше`);
});

server.on('exit', (code) => { stop(); process.exit(code ?? 0); });
