#!/usr/bin/env node
/**
 * Чего стоил разговор для каждого: доля реплик, молчания, кого звали и кто отвечал.
 * Считается по ленте, без единого вызова движка.
 *
 *   ./bin/worth зелёная
 *   ./bin/worth чёрная --since 24
 *
 * Это отчёт и только отчёт: состав комнаты по нему не правится. Комната — это её
 * состав, а не верхушка списка, и тот, кого сегодня не звали, завтра нужен первым.
 */
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { Orchestrator } from '../lib/orchestrator.js';
import { Store } from '../lib/store.js';
import { loadConfig } from '../lib/config.js';

const args = process.argv.slice(2);
if (!args.length || args.includes('--help') || args.includes('-h')) {
  console.log('worth <комната> [--since <seq>]');
  process.exit(0);
}
const i = args.indexOf('--since');
const since = i === -1 ? 0 : Number(args[i + 1] ?? 0);
const room = args[0];

const root = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
const config = loadConfig(root);
const orch = new Orchestrator({
  store: new Store(path.join(root, 'rooms')),
  config,
  log: { error() {} },
  build: () => ({ reset() {}, session() {}, async speak() { return { text: '' }; } }),
  stateDir: path.join(root, 'rooms'),
});

const rows = orch.worth(room, since);
if (!rows.length) {
  console.log(`в комнате «${room}» никого нет или её не существует`);
  process.exit(0);
}
console.log(`комната: ${room}${since ? ` (с реплики ${since})` : ''}\n`);
console.log('участник     движок  сказал  молчал  звали  ответил  доля');
console.log('─'.repeat(62));
for (const r of rows) {
  console.log(
    r.имя.padEnd(13) + r.движок.padEnd(8)
    + String(r.сказал).padEnd(8) + String(r.промолчал).padEnd(8)
    + String(r.звали).padEnd(7) + String(r.ответил).padEnd(9) + `${r.доля}%`,
  );
}
const строка = orch.worthLine(room, since);
if (строка) console.log(`\n${строка}`);
